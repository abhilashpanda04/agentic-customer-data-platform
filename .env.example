# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# NEVER commit the real `.env` file. It is excluded via .gitignore.

# --- Groq (optional: powers natural-language synthesis over tool outputs) ---
# Get a key at https://console.groq.com/keys
# The agent layer runs fully without this; it degrades to deterministic output.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Approval token signing (REQUIRED for campaign activation) ---
# Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing this value invalidates all previously issued approval tokens.
CDP_APPROVAL_SECRET=change-me-generate-a-random-secret

# --- Approval token lifetime in minutes (default: 60) ---
CDP_APPROVAL_TTL_MINUTES=60
